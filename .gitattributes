# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.json    text
*.yml     text
*.txt     text
*.md      text diff=markdown
*.ps1     text eol=crlf
# Shell scripts only run with LF.
*.sh      text eol=lf

# Small binaries that rarely change stay in git.
*.ico     binary
*.png     binary
*.webp    binary
